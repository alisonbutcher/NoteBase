# Database
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Message transport
# null     = Phase 1 (projection handler polls event store directly)
# rabbitmq = Phase 2
QUEUE_TRANSPORT=null
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@localhost:5672

# Projection store
# postgres = Phase 1
# dynamodb = Phase 2
PROJECTION_STORE=postgres

# DynamoDB (used when PROJECTION_STORE=dynamodb)
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# S3
S3_ENDPOINT=http://localhost:4566
S3_BUCKET=notebase-attachments
S3_REGION=ap-southeast-2

# Auth
# local    = bypass Cognito, use LOCAL_AUTH_USER_ID for all requests
# cognito  = validate Cognito JWTs (Phase 2)
AUTH_MODE=local
LOCAL_AUTH_USER_ID=00000000-0000-0000-0000-000000000001
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=ap-southeast-2

# App
PORT=3000
NODE_ENV=development
